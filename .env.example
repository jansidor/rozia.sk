# Verejná URL webu (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rozia.sk

# Supabase (región eu-central-1, Frankfurt). Bez nich web beží s prázdnymi dátami.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Len server (server actions zapisujú leady a čítajú pohľad comparables pre odhad ceny). Nikdy nie NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Ukážkové dáta na vývoj a dizajnové náhľady. V produkcii sa ignoruje.
ROZIA_DEMO_DATA=0

# Príjem leadov z nacenime.sk (webhook): tajomstvo na overenie podpisu (HMAC-SHA256), rovnaká hodnota ako NACENIME_LEAD_WEBHOOK_SECRET na strane nacenime.
# Min. 32 znakov (openssl rand -hex 32). Pri výmene tajomstva doplň staré do _PREVIOUS, potom ho odstráň. Len server, nikdy NEXT_PUBLIC_.
NACENIME_WEBHOOK_SECRET=
NACENIME_WEBHOOK_SECRET_PREVIOUS=
