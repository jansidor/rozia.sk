# Verejná URL webu (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rozia.sk

# Supabase (región eu-central-1, Frankfurt). Bez nich web beží s prázdnymi dátami.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Len server (server actions zapisujú leady). Nikdy nie NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Ukážkové dáta na vývoj a dizajnové náhľady. V produkcii sa ignoruje.
ROZIA_DEMO_DATA=0
